{
  "name": "dengta-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node dist/src/app.js",
    "stop": "pkill -f 'node dist/src/app.js'",
    "build": "rm -rf dist && npx tsc && cp -r src/Test/mockData dist/src/Test/",
    "dev:setenv": "docker compose -f ./docker-compose-dev.yml --env-file ./.env.dev up -d --build",
    "dev:run": "nodemon --exec node --enable-source-maps --no-warnings=ExperimentalWarning --loader ts-node/esm --env-file=./.env.dev ./src/app.ts",
    "dev": "npm run dev:setenv && npm run dev:run",
    "devi:setenv": "docker compose -f ./docker-compose-dev.yml --env-file ./.env.dev up -d --build",
    "devi": "infisical run --env=dev --path=/share -- concurrently -c 'blue.bold,red.bold' 'npx tsc --watch' 'nodemon -q dist/src/app.js'",
    "test": "infisical run --env=dev --path=/share --command=\"cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test npx jest --runInBand --coverage --forceExit\"",
    "test:ci": "infisical run --env=staging --path=/share --command=\"cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test npx jest --runInBand --coverage --forceExit\"",
    "load-test": "infisical run --env=dev --path=/share --command=\"k6 run src/Test/k6_tests/main.js\"",
    "load-test:ci": "infisical run --env=staging --path=/share --command=\"npm run build && npm run start & sleep 10 && k6 run src/Test/k6_tests/main.js && npm run stop\"",
    "staging": "docker compose -f ./docker-compose.yml --env-file ./.env.staging up -d --build",
    "lint": "npx eslint .",
    "prettier": "npx prettier --write .",
    "prepare": "if [ \"$CUSTOM_ENV\" != \"prod\" ] && [ \"$CUSTOM_ENV\" != \"staging\" ]; then husky install; fi"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@zilliz/milvus2-sdk-node": "^2.4.4",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cls-hooked": "^4.2.2",
    "dotenv": "^16.4.5",
    "eta": "^3.5.0",
    "express": "^4.18.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^14.1.2",
    "mime-types": "^2.1.35",
    "minio": "^8.0.1",
    "mjml": "^4.15.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.2",
    "nodemailer": "^6.9.15",
    "nodejieba": "^3.4.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/bcrypt": "^5.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.5.0",
    "globals": "^15.6.0",
    "husky": "^9.1.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "3.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.14.1"
  }
}
